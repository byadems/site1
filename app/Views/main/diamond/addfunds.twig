{% include 'main/diamond/header.twig' %}

<div class="container">
  <div class="row">
    <div class="col-md-12">
        {% if error %}
          <div class="alert alert-dismissible alert-danger">
            <button type="button" class="close" data-dismiss="alert">-</button>
            {{ errorText }}
          </div>
        {% endif %}
        {% if success %}
          <div class="alert alert-dismissible alert-success">
            <button type="button" class="close" data-dismiss="alert">-</button>
            {{ successText }}
          </div>
        {% endif %}
    </div>
  </div>

  <div class="row">
    <!-- SOL SUTUN (FORMLAR) -->
    <div class="col-md-6">
        {% if paymentsList %}
          <div class="well">
              <form method="post" action="addfunds">
                <div class="form-group">
                  <label for="payment_method" class="control-label">{{ lang['addfunds.method'] }}</label>
                  <select class="form-control" id="payment_method" name="payment_type">
                   {% for payment in paymentsList %}
                      <option value="{{ payment['id'] }}" {% if data['payment_type'] == payment['id'] %} selected {% endif %} >{{ payment['method_name'] }}</option>
                    {% endfor %}
                  </select>
                </div>

                <div class="form-group">
                    <label for="payment_amount" class="control-label">{{ lang['addfunds.amount'] }}</label>
                    <input class="form-control" id="payment_amount" name="payment_amount" value="{{ data['payment_amount'] }}">
                </div>

                <button type="submit" class="btn btn-primary">{{ lang['addfunds.button'] }}</button>
              </form>
          </div>
        {% endif %}

        {% if bankPayment == 2 %}
          <div class="well">
              <form method="post" action="addfunds">
                <div class="form-group">
                  <label for="payment_bank" class="control-label">{{ lang['addfunds.bank'] }}</label>
                  <select class="form-control" name="payment_bank">
                   {% for bank in bankList %}
                      <option value="{{ bank['id'] }}" {% if data['payment_bank'] == payment['id'] %} selected {% endif %} >{{ bank['bank_name'] }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label for="payment_bank_amount" class="control-label">{{ lang['addfunds.bank.amount'] }}</label>
                        <input class="form-control" name="payment_bank_amount" value="{{ data['payment_bank_amount'] }}">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="payment_gonderen" class="control-label">{{ lang['addfunds.bank.sender'] }}</label>
                        <input class="form-control" name="payment_gonderen" value="{{ data['payment_gonderen'] }}">
                    </div>
                </div>
                <div class="form-group">
                  <button type="submit" class="btn btn-primary btn-block">{{ lang['addfunds.bank.button'] }}</button>
                </div>
              </form>
          </div>
        {% endif %}
    </div>

    <!-- SAG SUTUN (ACIKLAMALAR & BANKA HESAPLARI) -->
    <div class="col-md-6">
        <!-- Odeme Yontemi Talimati (Dinamik) -->
        <div class="well" id="dynamic_payment_content" style="display:none;">
            <!-- JS ile doldurulacak -->
        </div>
        
        <!-- Genel Sayfa Icerigi -->
        {% if contentText %}
          <div class="well">
            {{ contentText }}
          </div>
        {% endif %}

        <!-- Banka Hesaplari Listesi -->
        {% if bankPayment == 2 %}
          <div class="well">
              <p style="text-align: center;">
                <span style="font-weight: 700; font-size: 36px;">Banka</span><span style="font-size: 36px;"> Hesaplarmz</span>
              </p>
              <div class="table-responsive">
                <table class="table table-striped table-bordered table-checkable ">
                  <thead>
                    <tr>
                      <th>Banka Ad</th>
                      <th>?ube Kodu</th>
                      <th>Hesap No</th>
                      <th>IBAN</th>
                      <th>Alc Ad</th>
                    </tr>
                  </thead>
                  <tbody>
                  {% for bank in bankList %}
                    <tr>
                      <td>{{ bank['bank_name'] }}</td>
                      <td>{{ bank['bank_sube'] }}</td>
                      <td>{{ bank['bank_hesap'] }}</td>
                      <td><b>{{ bank['bank_iban'] }}</b><br></td>
                      <td>{{ bank["bank_alici"] }}</td>
                    </tr>
                  {% endfor %}
                  </tbody>
                </table>
              </div>
              <div class="table-responsive">
                <table class="table table-striped table-bordered table-checkable ">
                  <tbody>
                    <tr>
                      <td>
                        <b>BLGLENDRME: </b> -deme yaplrken kesilen Havale/EFT Ǭcretleri tarafmzca <b>karYlanmayacaktr</b>.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
          </div>
        {% endif %}
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    var paymentContents = {
        {% for payment in paymentsList %}
            "{{ payment['id'] }}": `{{ payment['content']|raw }}`,
        {% endfor %}
    };

    var paymentSelect = document.getElementById('payment_method');
    var contentDiv = document.getElementById('dynamic_payment_content');

    if(paymentSelect) {
        paymentSelect.addEventListener('change', function() {
            var selectedId = this.value;
            var content = paymentContents[selectedId] || '';
            if(content.trim() !== '') {
                contentDiv.innerHTML = content;
                contentDiv.style.display = 'block';
            } else {
                contentDiv.innerHTML = '';
                contentDiv.style.display = 'none';
            }
        });
        
        paymentSelect.dispatchEvent(new Event('change'));
    }
});
</script>

{% include 'main/diamond/footer.twig' %}
